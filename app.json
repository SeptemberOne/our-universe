{
  "expo": {
    "name": "Our Universe",
    "slug": "our-universe",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "our-universe",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Our Universe to access your photo library so you can share private memories with your partner."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070B1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

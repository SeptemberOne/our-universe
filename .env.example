# Supabase public client configuration for the Expo mobile app.
# Copy this file to .env for local development (never commit .env).
#
# SECURITY: Only use the public anon / publishable key here.
# NEVER put a Supabase service_role or secret key in .env or mobile app code.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
